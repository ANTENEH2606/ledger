# Copy this file to .env and change the password. .env is never committed.
PG_PASSWORD=change-me

# Used by the Makefile and by `go test` on your own machine.
# Use the same password as above.
DATABASE_URL=postgres://ledger:change-me@localhost:5433/ledger?sslmode=disable
TEST_DATABASE_URL=postgres://ledger:change-me@localhost:5433/ledger_test?sslmode=disable